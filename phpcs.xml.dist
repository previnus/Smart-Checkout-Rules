<?xml version="1.0"?>
<ruleset name="Smart Checkout Rules">
    <description>WordPress coding and security rules for runtime PHP.</description>
    <file>smart-checkout-rules</file>
    <arg name="extensions" value="php"/>
    <rule ref="WordPress">
        <!-- PSR-4 class paths follow the implementation plan. Typed methods document their own signatures. -->
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="Squiz.Commenting"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.classFound"/>
    </rule>
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>
</ruleset>
